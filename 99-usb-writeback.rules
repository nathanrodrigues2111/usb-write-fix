# Cap dirty page cache for USB disks so copy progress is real and unplug loses at most 16 MB
ACTION=="add|change", SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", ENV{ID_BUS}=="usb", RUN+="/bin/sh -c 'echo 1 > /sys/block/%k/bdi/strict_limit; echo 16777216 > /sys/block/%k/bdi/max_bytes'"
# Clear the NTFS dirty flag left by an unplug without eject, so the stick mounts read-write.
# ntfsfix refuses mounted or hibernated (Windows fast startup) volumes, so this is safe.
ACTION=="add", SUBSYSTEM=="block", ENV{DEVTYPE}=="partition", ENV{ID_BUS}=="usb", ENV{ID_FS_TYPE}=="ntfs", RUN+="/usr/bin/ntfsfix -d /dev/%k"
